# Sciforium (OpenAI-compatible). Without these the app runs on its offline rules fallback.
SCIFORIUM_API_KEY=your-key-here
# Exact model string from compute setup, e.g. /deployments/<DEPLOYMENT ID>/deepseek-ai/DeepSeek-V4.1-Flash
SCIFORIUM_MODEL=your-model-string-here

# Optional
# SIM_PERSONA_LLM=1          # let the LLM improvise the simulated nurses (default: scripted, repeatable)
# DEMO_DATE=2026-09-27       # the day the 5:30 AM scenario happens (default: today)
# HOSPITAL_NAME=St. Brigid Medical Center
# PORT=8000

# Experimental real-phone path (see docs/vapi.md)
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
